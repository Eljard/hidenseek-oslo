---
import '@/styles/globals.css';
import '@/oslo/oslo.css';
import { ToastContainer } from 'react-toastify';
---
<!doctype html>
<html lang="nb">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#faf7ef" />
<meta name="description" content="Hele Oslo er spillebrettet ditt. Et lekent gjemselkart med T-bane, trikk, buss og tog." />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<title>Hide &amp; Seek Oslo — Byen er spillebrettet</title>
</head>
<body class="oslo-theme"><slot /><ToastContainer client:only="react" position="bottom-center" /></body>
</html>
