---
import '@/styles/globals.css';
import '@/oslo/oslo.css';
import '@/game/game.css';
import { ToastContainer } from 'react-toastify';
---
<!doctype html>
<html lang="nb">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#faf7ef" />
<meta name="description" content="Gjemsel i Oslo med delte spill, spørsmål, varsler og kollektivkart." />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<title>Hide &amp; Seek Oslo</title>
</head>
<body class="oslo-theme"><slot /><ToastContainer client:only="react" position="bottom-center" /></body>
</html>
